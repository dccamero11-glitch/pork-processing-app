APP_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=set-in-host-secret-manager
ADMIN_PASSWORD=replace-with-strong-password
MANAGER_BANGBUATHONG_PASSWORD=replace-with-strong-password
MANAGER_TRANG_PASSWORD=replace-with-strong-password
MANAGER_LANGSUAN_PASSWORD=replace-with-strong-password
